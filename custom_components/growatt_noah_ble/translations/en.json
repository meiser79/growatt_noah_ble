          "mqtt_host": "MQTT server",
          "mqtt_port": "MQTT port",
          "wifi_ssid": "WLAN name (SSID)",
          "wifi_password": "WLAN password",
          "enforce": "Restore settings automatically",
          "scan_interval": "Poll interval"
        },
        "data_description": {
          "mqtt_host": "e.g. mqtt.example.com. Leave empty to not manage the server.",
          "wifi_ssid": "Optional. Re-sent when the NOAH loses its WLAN connection.",
          "enforce": "Restores the MQTT server/port as soon as the NOAH forgets them and re-sends the WLAN credentials if the NOAH has no WLAN connection on two polls in a row."
        }
      }
    },
    "error": {
      "not_in_range": "The NOAH is not in range of a Bluetooth adapter or proxy.",
      "cannot_connect": "Bluetooth connection or authentication failed. Is the ShinePhone app still connected?"
