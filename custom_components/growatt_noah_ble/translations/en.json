{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Select NOAH",
        "description": "Select the NOAH or enter its Bluetooth MAC address.",
        "data": {
          "address": "Device"
        }
      },
      "settings": {
        "title": "{name}",
        "description": "Which settings should Home Assistant keep on the NOAH?",
